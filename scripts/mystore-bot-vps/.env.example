# ==============================================================================
# MyStore Telegram Admin Bot - Environment Configuration Template
# Copy this file to .env and fill in your credentials
# ==============================================================================

# Telegram Bot API Token & Authorized Admin Telegram IDs (Comma-separated)
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ
ADMIN_IDS=7251749429,7249511572

# Telegram MTProto User Session & Channel Cloud Storage (Zero-RAM Forwarding)
STORAGE_CHANNEL_ID=-1003887776900
TELEGRAM_API_ID=29116029
TELEGRAM_API_HASH=your_telegram_api_hash_here
TELEGRAM_SESSION_NAME=mystore_permanent_session
TELEGRAM_STRING_SESSION=

# GitHub Releases & Binary Asset Hosting
GITHUB_TOKEN=ghp_your_github_token_here
GITHUB_OWNER=your_github_username_or_org
GITHUB_REPO=appstore

# Firebase Realtime Database
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com

# Shared Security & Web Store Integration
ADMIN_SECURITY_TOKEN=sec_mystore_your_random_secret_token
STORE_WEB_URL=https://your-domain.pages.dev

# ImgBB Cloud Image Hosting API (for logos & screenshots)
IMGBB_API_KEY=your_imgbb_api_key_here
