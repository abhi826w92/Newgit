# ==============================================================================
# 🚀 GITHUB VPS & BOT CONTROLLER - ENVIRONMENT VARIABLES CONFIGURATION (.env)
# ==============================================================================
# Copy this file to '.env' or add these variables in your GitHub Repository Secrets:
# GitHub Repo -> Settings -> Secrets and variables -> Actions -> New repository secret
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 🤖 TELEGRAM CONTROLLER BOT CONFIGURATION (REQUIRED)
# ------------------------------------------------------------------------------
# The Telegram Bot Token created via @BotFather to control the server & bots.
TG_BOT_TOKEN="1234567890:ABCdefGHIjklMNOpqrsTUVwxyz123456789"

# The Telegram User ID(s) of the authorized administrator(s) (comma-separated if multiple).
# Get your numeric User ID from @userinfobot or @MissRose_bot on Telegram.
ADMIN_ID="7249511572"

# ------------------------------------------------------------------------------
# 2. 🔑 GITHUB PERSONAL ACCESS TOKEN (REQUIRED FOR SYNC & DISPATCH)
# ------------------------------------------------------------------------------
# GitHub Personal Access Token (Classic) with scopes: [repo, workflow, admin:repo_hook]
# Generate at: https://github.com/settings/tokens
GH_PAT="ghp_YourGitHubPersonalAccessTokenHere"

# ------------------------------------------------------------------------------
# 3. ⚙️ SERVER RUNTIME & DURATION CONFIGURATION (OPTIONAL)
# ------------------------------------------------------------------------------
# Maximum execution time (in seconds) per manual workflow run before clean shutdown.
# Default: 7200 seconds (2.0 Hours)
RUN_DURATION_SECONDS="7200"

# Target branch to synchronize with GitHub (Default: main)
WORKFLOW_REF="main"

# Workflow YAML file name in .github/workflows/ (Default: server.yml)
WORKFLOW_FILE="server.yml"

# ==============================================================================
# 💡 NOTE ON PER-BOT ENVIRONMENT SECRETS (.env_vault.json):
# Individual bot secrets (like API_ID, API_HASH, DATABASE_URL, etc.) are managed
# and securely AES-256 encrypted directly through your Telegram Bot Dashboard!
# ==============================================================================
